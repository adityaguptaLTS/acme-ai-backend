# Server Configuration
PORT=5181
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins.
# In development, defaults to Vite frontend origins (e.g. http://localhost:5173).
# In production, explicit origins are required; wildcard origins are not permitted by default.
CORS_ORIGIN=http://localhost:5173

# Request Body Limit
REQUEST_BODY_LIMIT=1mb

# Local AI Runtime Configuration
# Target model for ACME AI: gpt-oss-20b
AI_MODEL_NAME=gpt-oss-20b

# The base URL of the confirmed local inference engine running on company infrastructure.
# Examples when confirmed: http://127.0.0.1:11434 (Ollama) or http://127.0.0.1:8000 (vLLM)
# Leave blank or unconfigured until the local runtime and endpoint are confirmed on the host.
AI_RUNTIME_URL=http://localhost:11434/api/generate

# Timeout for AI inference requests in milliseconds (default: 30000ms / 30s)
AI_REQUEST_TIMEOUT_MS=30000
